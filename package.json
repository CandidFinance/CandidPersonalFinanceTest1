{
  "name": "candid-finance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-static-pages.js && node scripts/prerender.js",
    "preview": "vite preview",
    "check:screens": "node scripts/screen-check.js",
    "check:key": "node scripts/screen-check.js --key",
    "verify": "npm run build && npm run check:screens",
    "test": "node --import ./src/lib/testClock.js --test \"src/lib/*.test.js\" \"scripts/*.test.js\" \"scripts/personas/*.test.js\" \"scripts/assist-agent/*.test.js\"",
    "assist-agent": "node scripts/assist-agent/agent.js",
    "personas": "node scripts/personas/run.js && node scripts/personas/build-page.js"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "framer-motion": "^13.1.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.33.0",
    "posthog-js": "^1.96.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.4",
    "truelayer-signing": "^0.2.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "playwright": "^1.55.1",
    "vite": "^5.0.0"
  }
}
