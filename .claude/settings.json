{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git stash *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git rm *)",
      "Bash(git check-ignore *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(npm ls *)",
      "Bash(npx vite *)",
      "Bash(node --check *)",
      "Bash(node -e ' *)",
      "Bash(node_modules/.bin/esbuild.cmd *)",
      "Bash(grep *)",
      "Bash(awk 'NR==*)",
      "Bash(curl -s http://localhost*)",
      "Bash(tasklist)",
      "Bash(netstat -ano)",
      "mcp__claude_ai_Supabase__list_projects",
      "mcp__claude_ai_Supabase__list_tables",
      "mcp__claude_ai_Supabase__execute_sql",
      "mcp__claude_ai_Supabase__apply_migration",
      "mcp__claude_ai_PostHog__exec",
      "mcp__claude_ai_Vercel__list_deployments",
      "WebSearch",
      "WebFetch(domain:docs.truelayer.com)",
      "WebFetch(domain:www.moneysavingexpert.com)"
    ],
    "additionalDirectories": [
      "\\tmp"
    ]
  },
  "autoCompactWindow": 400000,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/context-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/test-guard.mjs\"",
            "timeout": 120,
            "statusMessage": "Running engine tests"
          }
        ]
      }
    ]
  }
}
