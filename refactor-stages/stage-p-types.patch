+ * @property {number} statePensionWeekly
+ * @property {number} statePensionAnnual
+ * @property {number} niYearsToFull
+ * @property {boolean} pastStatePensionAge
+ */
+
+/**
+ * Student loan
+ * @typedef {Object} StudentLoanMetrics
